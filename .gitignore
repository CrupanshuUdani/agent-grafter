/target/
Cargo.lock.bak

# Local-only build configuration. This project's canonical checkout can live on
# a filesystem that refuses to execute build artifacts, which requires pointing
# the target directory elsewhere. That path is machine-specific and must never
# be committed.
/.cargo/config.toml

# Local-only developer helpers carrying machine-specific paths.
/scripts-local/

# AI coding-agent settings and scratch state. This repo is private today but
# intended to go public once built; agent-tool config is machine/account
# specific and must never be committed or exposed, regardless of what any
# individual tool currently writes to it.
/.claude/
/.cursor/
/.codex/
/.aider*
/.windsurf/
/.cline/
CLAUDE.md
AGENTS.md

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
